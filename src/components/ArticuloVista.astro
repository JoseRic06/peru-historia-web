---
import { getEntry, render } from 'astro:content';
import Base from '../layouts/Base.astro';
import Fuentes from './Fuentes.astro';
import Video from './Video.astro';
import { formatoFecha, rutaImagen, textoEvento, urlAbsoluta, url } from '../lib/utils';
import { nombreEpoca } from '../lib/epocas';

interface Props {
  entry: any;
  seccion: 'historia' | 'explicadores';
}
const { entry, seccion } = Astro.props;
const d = entry.data;
const { Content } = await render(entry);
const actualizado: Date = d.fecha_actualizacion ?? d.fecha_publicacion;
const video = d.video_relacionado ? await getEntry('videos', d.video_relacionado) : null;
if (d.video_relacionado && !video) {
  throw new Error(`"${entry.id}": video_relacionado "${d.video_relacionado}" no existe en src/content/videos/.`);
}
const paginaUrl = urlAbsoluta(`${seccion}/${entry.id}/`, Astro.site);
---

<Base titulo={d.titulo} descripcion={d.resumen}>
  <article class="prose" data-pagefind-body>
    <p class="badge">
      {d.epoca ? nombreEpoca(d.epoca) : 'Explicador'}
      {d.fecha_evento !== undefined && ` · ${textoEvento(d.fecha_evento)}`}
    </p>
    <h1>{d.titulo}</h1>
    <p class="lead">{d.resumen}</p>
    <p class="meta">
      Publicado el {formatoFecha(d.fecha_publicacion)}
      {d.serie && <> · Serie: <strong>{d.serie}</strong></>}
    </p>
    <div>{d.etiquetas.map((t: string) => <span class="tag">{t}</span>)}</div>

    {d.imagenes.length > 0 && (
      <figure>
        <img src={rutaImagen(d.imagenes[0].archivo)} alt={d.imagenes[0].alt} loading="eager" />
        <figcaption>
          {d.imagenes[0].autor} · {d.imagenes[0].licencia}
          {d.imagenes[0].url_origen && <> · <a href={d.imagenes[0].url_origen}>origen</a></>}
        </figcaption>
      </figure>
    )}

    <div class="article-body"><Content /></div>

    {d.imagenes.slice(1).map((img: any) => (
      <figure>
        <img src={rutaImagen(img.archivo)} alt={img.alt} loading="lazy" />
        <figcaption>
          {img.autor} · {img.licencia}
          {img.url_origen && <> · <a href={img.url_origen}>origen</a></>}
        </figcaption>
      </figure>
    ))}

    {video && (
      <section>
        <h2>Video relacionado</h2>
        <Video titulo={video.data.titulo} url={video.data.url} plataforma={video.data.plataforma} />
      </section>
    )}

    <Fuentes fuentes={d.fuentes} actualizado={actualizado} paginaUrl={paginaUrl} />
    <p><a href={url(`${seccion}/`)}>← Volver a {seccion === 'historia' ? 'Historia' : 'Explicadores'}</a></p>
  </article>
</Base>
