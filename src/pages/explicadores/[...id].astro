---
import { explicadoresPublicados } from '../../lib/utils';
import ArticuloVista from '../../components/ArticuloVista.astro';

export async function getStaticPaths() {
  return (await explicadoresPublicados()).map((entry) => ({ params: { id: entry.id }, props: { entry } }));
}
const { entry } = Astro.props;
---

<ArticuloVista entry={entry} seccion="explicadores" />
