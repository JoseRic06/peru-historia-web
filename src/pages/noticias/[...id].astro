---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { noticiasPublicadas, formatoFecha, fechaISO, archiveUrl, urlAbsoluta, url } from '../../lib/utils';

export async function getStaticPaths() {
  return (await noticiasPublicadas()).map((entry) => ({ params: { id: entry.id }, props: { entry } }));
}
const { entry } = Astro.props;
const d = entry.data;
const { Content } = await render(entry);
const actualizado = d.fecha_actualizacion ?? d.fecha;
const paginaUrl = urlAbsoluta(`noticias/${entry.id}/`, Astro.site);
---

<Base titulo={d.titulo} descripcion={d.resumen}>
  <article class="prose" data-pagefind-body>
    <p class="badge"><time datetime={fechaISO(d.fecha)}>{formatoFecha(d.fecha)}</time></p>
    <h1>{d.titulo}</h1>
    <p class="lead">{d.resumen}</p>
    <div class="article-body"><Content /></div>

    <h2>Las noticias del día</h2>
    <ul>
      {d.noticias.map((n) => (
        <li>
          <strong>{n.titulo}</strong>
          <p>{n.resumen}</p>
          <p class="meta">
            Fuente: <a href={n.url} rel="noopener noreferrer">{n.medio}</a>
            · <a href={archiveUrl(n.url)} rel="noopener noreferrer">[copia]</a>
          </p>
        </li>
      ))}
    </ul>

    <section class="fuentes">
      <p class="article-foot">
        Última actualización: <time datetime={fechaISO(actualizado)}>{formatoFecha(actualizado)}</time>
        · <a href={archiveUrl(paginaUrl)} rel="noopener noreferrer">Ver copia de esta página en archive.org</a>
      </p>
    </section>
    <p><a href={url('noticias/')}>← Volver a Noticias</a></p>
  </article>
</Base>
